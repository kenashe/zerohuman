# ---------------------------------------------------------------------------
# ZeroHuman seller configuration. Copy to Railway → Service → Variables.
# NEVER commit real values. Secrets marked [SECRET].
# ---------------------------------------------------------------------------

# Chain: 1 = Ethereum mainnet, 11155111 = Sepolia.
CHAIN_ID=1
# One or more HTTPS RPC URLs, comma-separated (first is primary, rest are fallbacks).
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>,https://ethereum-rpc.publicnode.com
# [SECRET] New, dedicated, low-value seller hot wallet (npm run keygen). Never reuse a key.
SELLER_PRIVATE_KEY=
# First block to scan on a fresh database (set to the block at launch).
START_BLOCK=
# Durable state on the Railway volume.
DATABASE_PATH=/data/zerohuman.db
# Blocks to wait before treating an order (and a decision's target block) as final.
CONFIRMATIONS=6

# --- Buyer access ---------------------------------------------------------
# Initial deployment: ONLY these buyers are fulfilled. Others are held for review/refund.
BUYER_ALLOWLIST=0xYourTestBuyerAddress
# To accept everyone, set exactly: PUBLIC_BUYERS=I_APPROVE_PUBLIC_BUYERS (only after approval).
PUBLIC_BUYERS=
# Emergency stop (true = sign nothing).
PAUSED=false

# --- Gas & spending ceilings ------------------------------------------------
MAX_FEE_PER_GAS_GWEI=3
MAX_PRIORITY_FEE_GWEI=0.05
# Worst-case gas for one delivery (gasLimit × maxFee). Default 75% of the price.
MAX_DELIVERY_COST_WEI=75000000000000
DELIVERY_GAS_LIMIT_CAP=80000
# Rolling 24h ceiling on all gas spent by the seller (default 0.002 ETH).
DAILY_GAS_BUDGET_WEI=2000000000000000
MAX_ORDERS_PER_DAY=300
MIN_BALANCE_WEI=0
STUCK_AFTER_MS=180000
FEE_BUMP_PERCENT=20
MAX_REPLACEMENTS=3

# --- Encouragement model -----------------------------------------------------
LLM_PROVIDER=deepseek
# [SECRET]
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=220
LLM_DAILY_CALL_LIMIT=500

# --- Optional automatic revenue sweep to a cold wallet ------------------------
# SWEEP_TO_ADDRESS=0xColdWallet
# SWEEP_ABOVE_WEI=10000000000000000
# SWEEP_KEEP_WEI=3000000000000000

# --- Read-only HTTP (status API + dashboard) ------------------------------------
HTTP_ENABLED=true
# PORT is injected by Railway.
POLL_INTERVAL_MS=6000
LOG_LEVEL=info
