{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kenashe/zerohuman/main/schemas/catalog.schema.json",
  "$ref": "#/$defs/Catalog",
  "$defs": {
    "Catalog": {
      "type": "object",
      "properties": {
        "v": {
          "type": "string",
          "const": "zh/1"
        },
        "chainId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "seller": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "description": "Seller payment wallet; send orders here and expect deliveries from here"
        },
        "services": {
          "type": "object",
          "properties": {
            "decision": {
              "type": "object",
              "properties": {
                "price": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "offset": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "method": {
                  "type": "string"
                }
              },
              "required": [
                "price",
                "offset",
                "method"
              ],
              "additionalProperties": {}
            },
            "encouragement": {
              "type": "object",
              "properties": {
                "price": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "tones": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "price",
                "tones"
              ],
              "additionalProperties": {}
            }
          },
          "required": [
            "decision",
            "encouragement"
          ],
          "additionalProperties": false
        },
        "schema": {
          "type": "string",
          "format": "uri",
          "description": "URL of the machine-readable JSON Schemas"
        },
        "docs": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "type": "string",
          "enum": [
            "live",
            "allowlist",
            "paused",
            "retired"
          ]
        },
        "sla": {
          "type": "object",
          "properties": {
            "confirmations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "typicalSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "confirmations",
            "typicalSeconds",
            "maxSeconds"
          ],
          "additionalProperties": {}
        },
        "maxRequestBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "statusUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "v",
        "chainId",
        "seller",
        "services",
        "schema",
        "docs",
        "status",
        "sla",
        "maxRequestBytes"
      ],
      "additionalProperties": {},
      "title": "zh/1 service catalog (ENS text record com.zerohuman.services)"
    }
  },
  "x-zh-ens": {
    "name": "zerohuman.eth",
    "key": "com.zerohuman.services"
  }
}
