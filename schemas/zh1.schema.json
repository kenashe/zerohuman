{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kenashe/zerohuman/main/schemas/zh1.schema.json",
  "title": "ZeroHuman zh/1 protocol schemas",
  "$defs": {
    "decision-request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/kenashe/zerohuman/main/schemas/decision-request.schema.json",
      "$ref": "#/$defs/DecisionRequest",
      "$defs": {
        "DecisionRequest": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "number",
              "const": 1
            },
            "svc": {
              "type": "string",
              "const": "decision"
            },
            "opts": {
              "minItems": 2,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "description": "option: canonical UTF-8 string, 1..96 bytes, NFC, trimmed, no control characters"
              },
              "uniqueItems": true
            },
            "ctx": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "context: canonical UTF-8 string, 1..160 bytes, NFC, trimmed, no control characters"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "description": "ref: canonical UTF-8 string, 1..32 bytes, NFC, trimmed, no control characters"
            }
          },
          "required": [
            "zh",
            "svc",
            "opts"
          ],
          "additionalProperties": false,
          "title": "zh/1 Decision request (transaction input data)"
        }
      },
      "x-zh-encoding": "Transaction input data = raw UTF-8 bytes of one JSON object (no ABI encoding).",
      "x-zh-limits": {
        "requestBytes": 768,
        "responseBytes": 1024,
        "decisionMinOptions": 2,
        "decisionMaxOptions": 5,
        "decisionOptionMaxBytes": 96,
        "decisionContextMaxBytes": 160,
        "encouragementMessageMaxBytes": 280,
        "encouragementOutMessageMaxChars": 240,
        "encouragementOutStepMaxChars": 200,
        "refMaxBytes": 32
      },
      "x-zh-price-wei": "100000000000000",
      "x-zh-string-rules": "All strings must already be NFC-normalised, trimmed, contain no C0/C1 control, bidi-override, zero-width or BOM characters, and fit the UTF-8 byte limit. Non-canonical strings are rejected, not normalised."
    },
    "encouragement-request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/kenashe/zerohuman/main/schemas/encouragement-request.schema.json",
      "$ref": "#/$defs/EncouragementRequest",
      "$defs": {
        "EncouragementRequest": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "number",
              "const": 1
            },
            "svc": {
              "type": "string",
              "const": "encouragement"
            },
            "msg": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280,
              "description": "message: canonical UTF-8 string, 1..280 bytes, NFC, trimmed, no control characters"
            },
            "tone": {
              "type": "string",
              "enum": [
                "supportive",
                "playful"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "description": "ref: canonical UTF-8 string, 1..32 bytes, NFC, trimmed, no control characters"
            }
          },
          "required": [
            "zh",
            "svc",
            "msg"
          ],
          "additionalProperties": false,
          "title": "zh/1 Encouragement request (transaction input data)"
        }
      },
      "x-zh-encoding": "Transaction input data = raw UTF-8 bytes of one JSON object (no ABI encoding).",
      "x-zh-limits": {
        "requestBytes": 768,
        "responseBytes": 1024,
        "decisionMinOptions": 2,
        "decisionMaxOptions": 5,
        "decisionOptionMaxBytes": 96,
        "decisionContextMaxBytes": 160,
        "encouragementMessageMaxBytes": 280,
        "encouragementOutMessageMaxChars": 240,
        "encouragementOutStepMaxChars": 200,
        "refMaxBytes": 32
      },
      "x-zh-price-wei": "100000000000000",
      "x-zh-string-rules": "All strings must already be NFC-normalised, trimmed, contain no C0/C1 control, bidi-override, zero-width or BOM characters, and fit the UTF-8 byte limit. Non-canonical strings are rejected, not normalised."
    },
    "decision-response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/kenashe/zerohuman/main/schemas/decision-response.schema.json",
      "$ref": "#/$defs/DecisionResponse",
      "$defs": {
        "DecisionResponse": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "number",
              "const": 1
            },
            "re": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$",
              "description": "Original order transaction hash"
            },
            "ok": {
              "type": "boolean",
              "const": true
            },
            "svc": {
              "type": "string",
              "const": "decision"
            },
            "out": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "option": {
                  "type": "string"
                },
                "method": {
                  "type": "string",
                  "const": "zh-blockhash-v1"
                },
                "proof": {
                  "type": "object",
                  "properties": {
                    "orderBlock": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Block number that included the order transaction"
                    },
                    "offset": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Protocol block offset (5 in zh/1)"
                    },
                    "targetBlock": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "orderBlock + offset"
                    },
                    "targetBlockHash": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{64}$",
                      "description": "Hash of targetBlock on the canonical chain"
                    },
                    "seed": {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{64}$",
                      "description": "keccak256(targetBlockHash ‖ orderTxHash)"
                    },
                    "n": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 5
                    }
                  },
                  "required": [
                    "orderBlock",
                    "offset",
                    "targetBlock",
                    "targetBlockHash",
                    "seed",
                    "n"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "index",
                "option",
                "method",
                "proof"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "zh",
            "re",
            "ok",
            "svc",
            "out"
          ],
          "additionalProperties": false,
          "title": "zh/1 Decision response (delivery transaction input data)"
        }
      },
      "x-zh-algorithm": {
        "method": "zh-blockhash-v1",
        "offset": 5,
        "seed": "keccak256(blockhash(orderBlock + offset) ‖ orderTxHash)",
        "index": "uint256(seed) mod n"
      }
    },
    "encouragement-response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/kenashe/zerohuman/main/schemas/encouragement-response.schema.json",
      "$ref": "#/$defs/EncouragementResponse",
      "$defs": {
        "EncouragementResponse": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "number",
              "const": 1
            },
            "re": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$",
              "description": "Original order transaction hash"
            },
            "ok": {
              "type": "boolean",
              "const": true
            },
            "svc": {
              "type": "string",
              "const": "encouragement"
            },
            "out": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "nextStep": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "tone": {
                  "type": "string",
                  "enum": [
                    "supportive",
                    "playful"
                  ]
                },
                "gen": {
                  "type": "string",
                  "enum": [
                    "llm",
                    "fallback"
                  ],
                  "description": "Whether the text came from the model or the built-in fallback"
                }
              },
              "required": [
                "message",
                "nextStep",
                "tone",
                "gen"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "zh",
            "re",
            "ok",
            "svc",
            "out"
          ],
          "additionalProperties": false,
          "title": "zh/1 Encouragement response (delivery transaction input data)"
        }
      }
    },
    "error-response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/kenashe/zerohuman/main/schemas/error-response.schema.json",
      "$ref": "#/$defs/ErrorResponse",
      "$defs": {
        "ErrorResponse": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "number",
              "const": 1
            },
            "re": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "ok": {
              "type": "boolean",
              "const": false
            },
            "svc": {
              "type": "string",
              "maxLength": 32
            },
            "err": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "bad_json",
                    "bad_version",
                    "unknown_service",
                    "invalid_input",
                    "too_large",
                    "internal"
                  ]
                },
                "msg": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              "required": [
                "code",
                "msg"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "zh",
            "re",
            "ok",
            "err"
          ],
          "additionalProperties": false,
          "title": "zh/1 error response"
        }
      }
    },
    "catalog": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/kenashe/zerohuman/main/schemas/catalog.schema.json",
      "$ref": "#/$defs/Catalog",
      "$defs": {
        "Catalog": {
          "type": "object",
          "properties": {
            "v": {
              "type": "string",
              "const": "zh/1"
            },
            "chainId": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "seller": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "description": "Seller payment wallet; send orders here and expect deliveries from here"
            },
            "services": {
              "type": "object",
              "properties": {
                "decision": {
                  "type": "object",
                  "properties": {
                    "price": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "offset": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "method": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "price",
                    "offset",
                    "method"
                  ],
                  "additionalProperties": {}
                },
                "encouragement": {
                  "type": "object",
                  "properties": {
                    "price": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "tones": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "price",
                    "tones"
                  ],
                  "additionalProperties": {}
                }
              },
              "required": [
                "decision",
                "encouragement"
              ],
              "additionalProperties": false
            },
            "schema": {
              "type": "string",
              "format": "uri",
              "description": "URL of the machine-readable JSON Schemas"
            },
            "docs": {
              "type": "string",
              "format": "uri"
            },
            "status": {
              "type": "string",
              "enum": [
                "live",
                "allowlist",
                "paused",
                "retired"
              ]
            },
            "sla": {
              "type": "object",
              "properties": {
                "confirmations": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "typicalSeconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxSeconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "confirmations",
                "typicalSeconds",
                "maxSeconds"
              ],
              "additionalProperties": {}
            },
            "maxRequestBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "statusUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "v",
            "chainId",
            "seller",
            "services",
            "schema",
            "docs",
            "status",
            "sla",
            "maxRequestBytes"
          ],
          "additionalProperties": {},
          "title": "zh/1 service catalog (ENS text record com.zerohuman.services)"
        }
      },
      "x-zh-ens": {
        "name": "zerohuman.eth",
        "key": "com.zerohuman.services"
      }
    }
  }
}
